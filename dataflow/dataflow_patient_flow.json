{
	"name": "dataflow_patient_flow",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dataflow",
						"type": "DatasetReference"
					},
					"name": "patientdata"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "filterGen"
				},
				{
					"name": "sort1"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "surrogateKey1"
				},
				{
					"name": "select1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          patient_id as string,",
				"          first_name as string,",
				"          last_name as string,",
				"          gender as string,",
				"          date_of_birth as string,",
				"          state_code as string,",
				"          city as string,",
				"          phone as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> patientdata",
				"patientdata filter(gender == 'M') ~> filterGen",
				"filterGen sort(asc(state_code, true),",
				"     asc(city, true)) ~> sort1",
				"sort1 derive(patient_id = currentDate()) ~> derivedColumn1",
				"derivedColumn1 keyGenerate(output(pt_sk as long),",
				"     startAt: 1L,",
				"     stepValue: 1L) ~> surrogateKey1",
				"surrogateKey1 select(mapColumn(",
				"          first_name_patient = first_name,",
				"          patient_id,",
				"          last_name,",
				"          gender,",
				"          date_of_birth,",
				"          state_code,",
				"          city,",
				"          phone,",
				"          pt_sk",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1"
			]
		}
	}
}